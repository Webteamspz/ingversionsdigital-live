{
  "name": "ingversions-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "build": "node scripts/blog-thumbs.mjs && vite build && node scripts/prerender.mjs",
    "build:production": "node scripts/blog-thumbs.mjs && vite build --mode production && node scripts/prerender.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"scripts/**/*.mjs\" \"*.config.js\"",
    "preview": "vite preview",
    "build:staging": "node scripts/blog-thumbs.mjs && vite build --mode staging && node scripts/prerender.mjs staging",
    "test": "node --test \"src/**/*.test.js\""
  },
  "dependencies": {
    "html-react-parser": "^5.2.6",
    "lucide-react": "^1.33.0",
    "mermaid": "^11.17.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-helmet-async": "^3.0.0",
    "react-international-phone": "^4.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.4",
    "swiper": "^12.0.2",
    "vanilla-cookieconsent": "3.1.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.5.4",
    "baseline-browser-mapping": "^2.8.29",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "vite": "^7.1.7"
  }
}
